{
  "protocol_version": "blind-handoff-v0.1-draft",
  "construction_role": {
    "may_access": [
      "public corpus/query manifest",
      "hidden relevance judgments",
      "construction/adjudication notes",
      "canonical commitment generator"
    ],
    "must_publish_before_target_execution": [
      "public corpus/query manifest",
      "evaluator contract",
      "SHA-256 commitment to canonical hidden gold"
    ]
  },
  "target_execution_role": {
    "may_access": [
      "public corpus/query manifest",
      "source/passages permitted by the benchmark",
      "evaluator contract and ranked-run shape",
      "K",
      "hidden-gold commitment"
    ],
    "must_not_access_before_reveal": [
      "hidden gold/qrels",
      "construction/adjudication notes",
      "per-query expected metrics",
      "gold-derived identifiers or labels not already public"
    ]
  },
  "evaluator_role_after_reveal": {
    "may_access": [
      "exact target run",
      "revealed gold",
      "pre-reveal commitment",
      "public manifest",
      "frozen evaluator contract"
    ]
  },
  "repository_rule": "Hidden gold and construction notes must not exist in the target-execution repository snapshot or its reachable Git history before reveal. A directory name or convention is not an access control."
}
