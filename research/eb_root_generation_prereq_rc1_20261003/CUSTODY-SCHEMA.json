{
  "schema": "eb-root-generation-external-custody-rc1-v1",
  "producer": "external_launcher_or_custodian_not_writer_model",
  "purpose": "Verify writer aperture, chronology, response completeness, runtime facts and extracted profile identity without semantic self-attestation.",
  "required_fields": [
    "schema",
    "execution_id",
    "setup_commit",
    "started_at",
    "completed_at",
    "destination",
    "service_version",
    "reported_model",
    "reported_model_digest",
    "actual_backend_weight_attestation",
    "session_id",
    "no_history_mechanism",
    "opened_sources",
    "forbidden_sources_opened",
    "native_request_sha256",
    "native_response_sha256",
    "response_complete",
    "truncated",
    "done_reason",
    "extracted_files_sha256",
    "checker_result"
  ],
  "constraints": {
    "opened_sources": "Only bootstrap allowlist source files plus runtime facts; each source recorded with exact SHA-256.",
    "forbidden_sources_opened": "Must be an empty array for PASS.",
    "actual_backend_weight_attestation": "Use UNKNOWN unless independently observable.",
    "response_complete": true,
    "truncated": false,
    "extracted_files_sha256": [
      "PRIMARY-PROMPT.txt",
      "PRIMARY-CONFIG.json",
      "EVALUATOR-PROMPT.txt",
      "EVALUATOR-CONFIG.json",
      "REVIEW-SCHEMA.json"
    ],
    "checker_result": ["PASS", "FAIL"],
    "receipt_excludes": [
      "source bodies",
      "generated prompt bodies",
      "whole native request",
      "whole native response",
      "semantic cases",
      "oracle answers",
      "scientific outcomes"
    ]
  },
  "native_bytes": "Preserve native request and native response separately. The receipt references them only by digest and bounded metadata.",
  "model_generated_custody_receipt": false
}
